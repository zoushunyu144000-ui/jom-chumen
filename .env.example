# Copy to .env and fill. Never commit real secrets.

# Production Postgres (Neon recommended, region: Singapore / Asia).
# If empty, the app falls back to in-memory PGLite — data dies on restart.
DATABASE_URL=

# Auth must stay ON for this product.
VITE_AUTH_ENABLED=true

# Public origin of this deployment (OAuth callbacks + cookies).
BETTER_AUTH_URL=https://example.com
BETTER_AUTH_SECRET=replace-with-32-plus-random-bytes

# Only needed if you keep Google / X login via the Grok auth broker.
# Self-host with email/password does not need these.
# GROK_AUTH_ISSUER=https://auth.grok.me
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
