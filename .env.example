# Copy to .env and fill. Never commit real secrets.

DATABASE_URL=

VITE_AUTH_ENABLED=true

# Must be the live site origin.
BETTER_AUTH_URL=https://jom-chumen-2026.vercel.app
BETTER_AUTH_SECRET=replace-with-32-plus-random-bytes

# First-party Google login (not Grok broker).
# Create an OAuth client in Google Cloud Console.
# Authorized JavaScript origin:
#   https://jom-chumen-2026.vercel.app
# Authorized redirect URI:
#   https://jom-chumen-2026.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# Object storage. Cloudflare R2 is the recommended setup.
# R2_PUBLIC_URL should be the public custom domain / r2.dev base URL for this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Generic S3-compatible alternative. When set, S3_* takes precedence over R2_*.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_URL=
